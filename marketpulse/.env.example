APP_NAME=MARKETPULSE
APP_ENV=development

# Meta AI API Gateway
META_API_KEY=your_meta_api_key_here
META_BASE_URL=https://api.meta.ai/v1

# Multi-Model Architecture
META_MUSE_WONDER_MODEL=muse-wonder-1.0  # Exclusively for Chief Research Director
META_SPARK_MODEL=spark-1.3              # For all 7 specialist agents

# Web Search Provider (Tavily Search API)
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=8
TAVILY_TOPIC=general

# Stage 2 Autonomous Research Budget & Guardrails
MAX_RESEARCH_ITERATIONS=3
MAX_FOLLOWUP_SEARCHES=4
MAX_FOLLOWUP_TASKS=8
MAX_SEARCHES_PER_RESEARCH=15
MAX_RESULTS_PER_SEARCH=8
SEARCH_CACHE_TTL_HOURS=24
SEARCH_CACHE_ENABLED=true

# Database Persistence
DATABASE_URL=sqlite:///./marketpulse.db

# Execution Settings
ENABLE_MOCK_MODE=false
MAX_PARALLEL_AGENTS=3
